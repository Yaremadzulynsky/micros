FROM debian:bookworm-slim
RUN apt-get update && apt-get install -y --no-install-recommends build-essential cmake ninja-build python3 python3-venv ca-certificates && rm -rf /var/lib/apt/lists/*
RUN python3 -m venv /opt/micros-python
COPY tools/requirements-dev.txt /tmp/requirements.txt
RUN /opt/micros-python/bin/pip install --no-cache-dir -r /tmp/requirements.txt
